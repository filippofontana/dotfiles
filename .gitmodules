	path = nvim/dot-config
	url = https://github.com/filippofontana/kickstart.nvim.git
	branch = custom-configuration
[submodule "ghostty/dot-config"]
	path = ghostty/dot-config
	url = https://github.com/filippofontana/ghostty-config.git
[submodule "tmux/dot-config"]
	path = tmux/dot-config
	url = https://github.com/filippofontana/tmux.git
