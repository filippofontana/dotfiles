[submodule "nvim/config"]
	path = nvim/dot-config
	url = https://github.com/filippofontana/kickstart.nvim.git
	branch = custom-configuration
[submodule "ghostty/dot-config"]
	path = ghostty/dot-config
	url = https://github.com/filippofontana/ghostty-config.git
[submodule "tmux/dot-config"]
	path = tmux/dot-config
	url = https://github.com/filippofontana/tmux.git
[submodule "zsh/dot-oh-my-zsh/custom/themes/powerlevel10k"]
	path = zsh/dot-oh-my-zsh/custom/themes/powerlevel10k
	url = https://github.com/romkatv/powerlevel10k.git
[submodule "zsh/dot-oh-my-zsh/custom/plugins/zsh-autosuggestions"]
	path = zsh/dot-oh-my-zsh/custom/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions
[submodule "zsh/dot-oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
	path = zsh/dot-oh-my-zsh/custom/plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting
